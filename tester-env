#!/usr/bin/env bash
set -euo pipefail

# Gitea - Tester Environment CLI
# Usage: ./tester-env <command> [--ref <git-ref>] [--run-id <id>] [--port <port>]
# Commands: deploy, seed, verify, reset, stop, logs, status

RUN_ID="default"
PORT="3000"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TESTER_ENV_PROJECT="${TESTER_ENV_PROJECT:-tester-env}"
TESTER_ENV_APP="${TESTER_ENV_APP:-gitea}"
TESTER_ENV_SCENARIO="${TESTER_ENV_SCENARIO:-manual}"

refresh_names() {
    local suffix=""
    if [[ "${RUN_ID}" != "default" ]]; then
        suffix="-${RUN_ID}"
    fi

    CONTAINER_NAME="tester-env-gitea${suffix}"
    # IMAGE_TAG set by scripts/rl-env to a content-addressed tag so identical
    # (baseline, patch-set) combos share an image. Manual invocations get :dev.
    IMAGE_NAME="${IMAGE_TAG:-tester-env-gitea:dev}"
    DATA_VOLUME="tester-env-gitea-data${suffix}"
}

cmd_deploy() {
    local ref="${1:-}"

    if [[ -n "${ref}" ]]; then
        echo "==> Checking out ref: ${ref}"
        git -C "${SCRIPT_DIR}" checkout "${ref}"
        echo "==> Submodule now at: $(git -C "${SCRIPT_DIR}" rev-parse --short HEAD)"
    fi

    echo "==> Building Docker image..."
    docker build \
        --label "tester-env.project=${TESTER_ENV_PROJECT}" \
        --label "tester-env.app=${TESTER_ENV_APP}" \
        --label "tester-env.scenario=${TESTER_ENV_SCENARIO}" \
        -t "${IMAGE_NAME}" \
        "${SCRIPT_DIR}"

    echo "==> Starting container on port ${PORT}..."
    # Browser-origin contract (docs/APP_CLI_PATTERN.md): the runner's browser
    # reaches the app at the bridge gateway, not localhost. Default Gitea's
    # absolute-URL settings from TESTER_ENV_BROWSER_ORIGIN, falling back to
    # localhost:$PORT for manual runs. Never override an explicit operator
    # value (GITEA__server__ROOT_URL). In launcher/tunnel mode the launcher
    # patch prepends TESTER_ENV_PUBLIC_ORIGIN to this chain.
    EFFECTIVE_ORIGIN="${GITEA__server__ROOT_URL:-${TESTER_ENV_BROWSER_ORIGIN:-http://localhost:${PORT}}}"
    EFFECTIVE_ORIGIN="${EFFECTIVE_ORIGIN%/}"
    ORIGIN_HOST="${EFFECTIVE_ORIGIN#https://}"
    ORIGIN_HOST="${ORIGIN_HOST#http://}"
    ORIGIN_HOST="${ORIGIN_HOST%%/*}"
    ORIGIN_HOST="${ORIGIN_HOST%%:*}"
    if [[ -z "${ORIGIN_HOST}" ]]; then ORIGIN_HOST="localhost"; fi

    docker volume create \
        --label "tester-env.project=${TESTER_ENV_PROJECT}" \
        --label "tester-env.app=${TESTER_ENV_APP}" \
        --label "tester-env.scenario=${TESTER_ENV_SCENARIO}" \
        --label "tester-env.run_id=${TESTER_ENV_RUN_ID:-${RUN_ID}}" \
        "${DATA_VOLUME}" >/dev/null
    docker run -d --name "${CONTAINER_NAME}" \
        --label "tester-env.project=${TESTER_ENV_PROJECT}" \
        --label "tester-env.app=${TESTER_ENV_APP}" \
        --label "tester-env.scenario=${TESTER_ENV_SCENARIO}" \
        --label "tester-env.run_id=${TESTER_ENV_RUN_ID:-${RUN_ID}}" \
        -p "${PORT}:3000" \
        -v "${DATA_VOLUME}:/data" \
        -e "GITEA__security__SECRET_KEY=tester-env-secret-key-2026" \
        -e "GITEA__security__INTERNAL_TOKEN=tester-env-internal-token-2026" \
        -e "GITEA__security__MIN_PASSWORD_LENGTH=6" \
        -e "GITEA__server__DISABLE_SSH=true" \
        -e "GITEA__security__INSTALL_LOCK=true" \
        -e "GITEA__server__DOMAIN=${ORIGIN_HOST}" \
        -e "GITEA__server__SSH_DOMAIN=localhost" \
        -e "GITEA__server__ROOT_URL=${EFFECTIVE_ORIGIN}" \
        "${IMAGE_NAME}"

    echo "==> Waiting for app to start..."
    healthy=0
    for i in $(seq 1 30); do
        if curl -sf "http://localhost:${PORT}/api/v1/version" >/dev/null 2>&1; then
            echo "==> Gitea healthy at http://localhost:${PORT}"
            healthy=1
            break
        fi
        sleep 2
    done
    if [[ "${healthy}" != "1" ]]; then
        echo "ERROR: Gitea did not become healthy at http://localhost:${PORT}" >&2
        exit 1
    fi

    # The admin CLI races app config initialization right after the first
    # healthy probe ("Unable to load config file for a installed Gitea
    # instance"), so retry briefly. An existing admin is success (deploy is
    # re-runnable against a kept volume).
    echo "==> Creating admin user..."
    created=0
    create_out=""
    for i in $(seq 1 15); do
        if create_out=$(docker exec "${CONTAINER_NAME}" su-exec git gitea admin user create \
            --admin --username admin --password admin \
            --email admin@example.com --must-change-password=false 2>&1); then
            created=1
            break
        fi
        if echo "${create_out}" | grep -qi "already exist"; then
            echo "==> Admin user already exists."
            created=1
            break
        fi
        echo "==> Admin creation not ready yet (attempt ${i}/15), retrying in 2s..."
        sleep 2
    done
    if [[ "${created}" != "1" ]]; then
        echo "ERROR: failed to create admin user:" >&2
        echo "${create_out}" >&2
        exit 1
    fi

    echo "==> Deployment complete. App running at http://localhost:${PORT}"
}

# POST JSON to the Gitea API; HTTP 200/201/422 all count as success so seed
# is re-runnable (422 = already exists). Anything else prints the status and
# body and fails. BASE and AUTH are globals set by cmd_seed.
api_post() {
    local url="$1" data="$2" body code
    body=$(mktemp)
    code=$(curl -s -o "${body}" -w "%{http_code}" -u "${AUTH}" -X POST "${url}" \
        -H "Content-Type: application/json" -d "${data}" || true)
    if [[ "${code}" == "200" || "${code}" == "201" || "${code}" == "422" ]]; then
        cat "${body}"
        rm -f "${body}"
        return 0
    fi
    echo "ERROR: POST ${url} -> HTTP ${code}" >&2
    cat "${body}" >&2
    rm -f "${body}"
    return 1
}

cmd_seed() {
    BASE="http://localhost:${PORT}/api/v1"
    AUTH="admin:admin"

    echo "==> Seeding Atlas Labs data..."

    # --- Users (skip users that already exist) ---
    echo "==> Creating users..."
    for user_json in \
        '{"username":"alice","email":"alice@atlaslabs.dev","password":"alice123","full_name":"Alice Chen","must_change_password":false,"send_notify":false}' \
        '{"username":"bob","email":"bob@atlaslabs.dev","password":"bob123","full_name":"Bob Martinez","must_change_password":false,"send_notify":false}' \
        '{"username":"charlie","email":"charlie@atlaslabs.dev","password":"charlie123","full_name":"Charlie Kim","must_change_password":false,"send_notify":false}'; do
        username=$(echo "${user_json}" | python3 -c "import sys,json; print(json.load(sys.stdin)['username'])")
        if curl -sf -u "${AUTH}" "${BASE}/users/${username}" >/dev/null 2>&1; then
            echo "  user ${username} already exists, skipping."
            continue
        fi
        api_post "${BASE}/admin/users" "${user_json}" >/dev/null
    done
    echo "==> Users ready: alice, bob, charlie"

    # --- Org (422-tolerant: re-run safe) ---
    echo "==> Creating org atlas-labs..."
    api_post "${BASE}/orgs" \
        '{"username":"atlas-labs","full_name":"Atlas Labs","description":"Atlas Labs Engineering","visibility":"public"}' >/dev/null

    # --- Team (skip if already present) ---
    echo "==> Creating team engineering..."
    EXISTING_TEAMS=$(curl -sf -u "${AUTH}" "${BASE}/orgs/atlas-labs/teams" || echo "[]")
    if echo "${EXISTING_TEAMS}" | python3 -c "import sys,json; sys.exit(0 if 'engineering' in [t.get('name') for t in json.load(sys.stdin)] else 1)"; then
        echo "  team engineering already exists, skipping."
    else
        api_post "${BASE}/orgs/atlas-labs/teams" \
            '{"name":"engineering","description":"Engineering team","permission":"write","units":["repo.code","repo.issues","repo.pulls","repo.releases","repo.wiki"]}' >/dev/null
    fi

    # --- Repos (skip repos that already exist) ---
    echo "==> Creating repos..."
    for repo_json in \
        '{"name":"checkout-service","description":"Customer checkout and payment processing service","auto_init":true,"default_branch":"main","private":false}' \
        '{"name":"data-pipeline","description":"ETL pipelines for analytics and reporting","auto_init":true,"default_branch":"main","private":false}' \
        '{"name":"frontend-app","description":"Customer-facing web application","auto_init":true,"default_branch":"main","private":false}'; do
        repo_name=$(echo "${repo_json}" | python3 -c "import sys,json; print(json.load(sys.stdin)['name'])")
        if curl -sf -u "${AUTH}" "${BASE}/repos/atlas-labs/${repo_name}" >/dev/null 2>&1; then
            echo "  repo atlas-labs/${repo_name} already exists, skipping."
            continue
        fi
        api_post "${BASE}/orgs/atlas-labs/repos" "${repo_json}" >/dev/null
    done
    echo "==> Repos ready: checkout-service, data-pipeline, frontend-app"

    # --- Labels for checkout-service (create only missing ones) ---
    echo "==> Creating labels for checkout-service..."
    EXISTING_LABELS=$(curl -sf -u "${AUTH}" "${BASE}/repos/atlas-labs/checkout-service/labels" || echo "[]")
    for label_json in \
        '{"name":"bug","color":"d73a4a","description":"Something is broken"}' \
        '{"name":"enhancement","color":"a2eeef","description":"New feature or request"}' \
        '{"name":"documentation","color":"0075ca","description":"Documentation changes"}' \
        '{"name":"priority-high","color":"b60205","description":"High priority"}' \
        '{"name":"priority-low","color":"0e8a16","description":"Low priority"}'; do
        label_name=$(echo "${label_json}" | python3 -c "import sys,json; print(json.load(sys.stdin)['name'])")
        if echo "${EXISTING_LABELS}" | python3 -c "import sys,json; sys.exit(0 if '${label_name}' in [l.get('name') for l in json.load(sys.stdin)] else 1)"; then
            echo "  label ${label_name} already exists, skipping."
            continue
        fi
        api_post "${BASE}/repos/atlas-labs/checkout-service/labels" "${label_json}" >/dev/null
    done
    echo "==> Labels ready"

    # --- Milestones for checkout-service (reuse the milestone if present) ---
    echo "==> Creating milestones for checkout-service..."
    EXISTING_MILESTONES=$(curl -sf -u "${AUTH}" "${BASE}/repos/atlas-labs/checkout-service/milestones?state=all" || echo "[]")
    MILESTONE_ID=$(echo "${EXISTING_MILESTONES}" | python3 -c "
import sys,json
ms=[m for m in json.load(sys.stdin) if m.get('title')=='v1.4.0 Gateway Stabilization']
print(ms[0]['id'] if ms else '')")
    if [[ -z "${MILESTONE_ID}" ]]; then
        MILESTONE_RESP=$(api_post "${BASE}/repos/atlas-labs/checkout-service/milestones" \
            '{"title":"v1.4.0 Gateway Stabilization","description":"Stabilize payment gateway integration and fix timeout issues","due_on":"2026-08-01T00:00:00Z"}')
        MILESTONE_ID=$(echo "${MILESTONE_RESP}" | python3 -c "import sys,json; print(json.load(sys.stdin)['id'])")
    else
        echo "  milestone v1.4.0 Gateway Stabilization already exists (id=${MILESTONE_ID}), reusing."
    fi
    echo "==> Milestone ready: v1.4.0 Gateway Stabilization (id=${MILESTONE_ID})"

    # --- Issues for checkout-service (skip as a group if any already exist) ---
    echo "==> Creating issues for checkout-service..."
    EXISTING_ISSUES=$(curl -sf -u "${AUTH}" "${BASE}/repos/atlas-labs/checkout-service/issues?state=all&limit=50" || echo "[]")
    EXISTING_ISSUE_COUNT=$(echo "${EXISTING_ISSUES}" | python3 -c "import sys,json; print(len(json.load(sys.stdin)))")
    if [[ "${EXISTING_ISSUE_COUNT}" != "0" ]]; then
        echo "  ${EXISTING_ISSUE_COUNT} issues already present, skipping issue creation."
    else
    # Issue 1: Open, enhancement, milestone
    api_post "${BASE}/repos/atlas-labs/checkout-service/issues" \
        "{\"title\":\"Implement payment gateway integration\",\"body\":\"Integrate Stripe and PayPal payment gateways for the checkout flow.\",\"labels\":[\"enhancement\"],\"milestone\":${MILESTONE_ID},\"assignee\":\"alice\"}" >/dev/null
    sleep 0.5

    # Issue 2: Open, enhancement, milestone
    api_post "${BASE}/repos/atlas-labs/checkout-service/issues" \
        "{\"title\":\"Add refund audit log notes\",\"body\":\"Add audit trail notes to refund transactions for compliance.\",\"labels\":[\"enhancement\"],\"milestone\":${MILESTONE_ID},\"assignee\":\"bob\"}" >/dev/null
    sleep 0.5

    # Issue 3: Open, bug, priority-high, milestone
    api_post "${BASE}/repos/atlas-labs/checkout-service/issues" \
        "{\"title\":\"Fix checkout timeout on large carts\",\"body\":\"Checkout times out when cart has more than 50 items due to synchronous tax calculation.\",\"labels\":[\"bug\",\"priority-high\"],\"milestone\":${MILESTONE_ID},\"assignee\":\"alice\"}" >/dev/null
    sleep 0.5

    # Issue 4: Closed, documentation
    ISSUE4_RESP=$(api_post "${BASE}/repos/atlas-labs/checkout-service/issues" \
        '{"title":"Set up CI/CD pipeline","body":"Configure GitHub Actions for build, test, and deploy workflow.","labels":["documentation"],"assignee":"charlie"}')
    ISSUE4_INDEX=$(echo "${ISSUE4_RESP}" | python3 -c "import sys,json; print(json.load(sys.stdin)['number'])")

    # Close issue #4
    curl -sf -u "${AUTH}" -X PATCH "${BASE}/repos/atlas-labs/checkout-service/issues/${ISSUE4_INDEX}" \
        -H "Content-Type: application/json" \
        -d '{"state":"closed"}' >/dev/null

    echo "==> Created 4 issues (3 open, 1 closed)"
    fi

    # --- Branch (skip if already present) ---
    echo "==> Creating feature branch..."
    if curl -sf -u "${AUTH}" "${BASE}/repos/atlas-labs/checkout-service/branches/feature%2Frefund-audit-log" >/dev/null 2>&1; then
        echo "  branch feature/refund-audit-log already exists, skipping."
    else
        # Get main branch SHA
        MAIN_RESP=$(curl -sf -u "${AUTH}" "${BASE}/repos/atlas-labs/checkout-service/git/refs/heads/main")
        MAIN_SHA=$(echo "${MAIN_RESP}" | python3 -c "import sys,json; print(json.load(sys.stdin)['object']['sha'])")

        api_post "${BASE}/repos/atlas-labs/checkout-service/git/refs" \
            "{\"ref\":\"refs/heads/feature/refund-audit-log\",\"sha\":\"${MAIN_SHA}\"}" >/dev/null
        echo "==> Created branch: feature/refund-audit-log"
    fi

    # --- PR (skip if any PR already exists) ---
    echo "==> Creating pull request..."
    EXISTING_PRS=$(curl -sf -u "${AUTH}" "${BASE}/repos/atlas-labs/checkout-service/pulls?state=all" || echo "[]")
    EXISTING_PR_COUNT=$(echo "${EXISTING_PRS}" | python3 -c "import sys,json; print(len(json.load(sys.stdin)))")
    if [[ "${EXISTING_PR_COUNT}" != "0" ]]; then
        echo "  ${EXISTING_PR_COUNT} pull request(s) already present, skipping."
    else
        api_post "${BASE}/repos/atlas-labs/checkout-service/pulls" \
            '{"title":"Add refund audit log notes","body":"Closes #2 - Adds audit trail notes to refund transactions.","head":"feature/refund-audit-log","base":"main"}' >/dev/null
        echo "==> Created PR: Add refund audit log notes"
    fi

    # --- Release (skip if the tag already exists) ---
    echo "==> Creating release..."
    if curl -sf -u "${AUTH}" "${BASE}/repos/atlas-labs/checkout-service/releases/tags/v1.4.0" >/dev/null 2>&1; then
        echo "  release v1.4.0 already exists, skipping."
    else
        api_post "${BASE}/repos/atlas-labs/checkout-service/releases" \
            '{"tag_name":"v1.4.0","target_commitish":"main","name":"v1.4.0 Gateway Stabilization","body":"## Changes\n- Payment gateway integration\n- Refund audit log notes\n- Fix checkout timeout on large carts\n- CI/CD pipeline","draft":false,"prerelease":false}' >/dev/null
        echo "==> Created release: v1.4.0 Gateway Stabilization"
    fi

    # --- Wiki page (skip if already present) ---
    echo "==> Creating wiki page..."
    EXISTING_WIKI=$(curl -sf -u "${AUTH}" "${BASE}/repos/atlas-labs/checkout-service/wiki/pages" || echo "[]")
    if echo "${EXISTING_WIKI}" | python3 -c "import sys,json; sys.exit(0 if 'Incident Response' in [p.get('title') for p in json.load(sys.stdin)] else 1)"; then
        echo "  wiki page Incident Response already exists, skipping."
    else
        WIKI_CONTENT_B64=$(echo -n "# Incident Response\n\n## Overview\n\nThis document describes the incident response procedures for the checkout-service.\n\n## Triage\n\n1. Identify the incident severity.\n2. Notify the on-call engineer via PagerDuty.\n3. Create a status page incident.\n\n## Escalation\n\n| Severity | Response Time | Escalation |\n|----------|--------------|------------|\n| Sev1 | 15 minutes | Engineering Manager |\n| Sev2 | 30 minutes | Team Lead |\n| Sev3 | 2 hours | Sprint Owner |\n\n## Post-Mortem\n\nAll Sev1 and Sev2 incidents require a post-mortem within 5 business days." | base64 -w0)

        api_post "${BASE}/repos/atlas-labs/checkout-service/wiki/new" \
            "{\"title\":\"Incident Response\",\"content_base64\":\"${WIKI_CONTENT_B64}\"}" >/dev/null
        echo "==> Created wiki page: Incident Response"
    fi

    echo "==> Seeding complete."
}

cmd_verify() {
    local BASE="http://localhost:${PORT}/api/v1"
    local AUTH="admin:admin"
    local errors=0

    echo "==> Verifying seeded state..."

    # Check org
    echo "==> Checking org atlas-labs..."
    if ! curl -sf -u "${AUTH}" "${BASE}/orgs/atlas-labs" >/dev/null 2>&1; then
        echo "ERROR: org atlas-labs not found"
        errors=$((errors + 1))
    else
        echo "  org atlas-labs: OK"
    fi

    # Check repos
    echo "==> Checking repos..."
    REPOS_RESP=$(curl -sf -u "${AUTH}" "${BASE}/orgs/atlas-labs/repos")
    REPO_COUNT=$(echo "${REPOS_RESP}" | python3 -c "import sys,json; print(len(json.load(sys.stdin)))")
    if [[ "${REPO_COUNT}" != "3" ]]; then
        echo "ERROR: expected 3 repos, got ${REPO_COUNT}"
        errors=$((errors + 1))
    else
        echo "  repos count: ${REPO_COUNT} OK"
    fi

    # Check checkout-service issues
    echo "==> Checking checkout-service issues..."
    ISSUES_RESP=$(curl -sf -u "${AUTH}" "${BASE}/repos/atlas-labs/checkout-service/issues?state=all&limit=20")
    ISSUE_COUNT=$(echo "${ISSUES_RESP}" | python3 -c "import sys,json; items=json.load(sys.stdin); print(len(items))")
    OPEN_COUNT=$(echo "${ISSUES_RESP}" | python3 -c "import sys,json; items=json.load(sys.stdin); print(sum(1 for i in items if i['state']=='open'))")
    if [[ "${ISSUE_COUNT}" != "4" ]]; then
        echo "ERROR: expected 4 checkout issues, got ${ISSUE_COUNT}"
        errors=$((errors + 1))
    else
        echo "  checkout_issues: ${ISSUE_COUNT} OK"
    fi
    if [[ "${OPEN_COUNT}" != "3" ]]; then
        echo "ERROR: expected 3 open checkout issues, got ${OPEN_COUNT}"
        errors=$((errors + 1))
    else
        echo "  open_checkout_issues: ${OPEN_COUNT} OK"
    fi

    # Check branches
    echo "==> Checking branches..."
    BRANCHES_RESP=$(curl -sf -u "${AUTH}" "${BASE}/repos/atlas-labs/checkout-service/branches")
    BRANCH_COUNT=$(echo "${BRANCHES_RESP}" | python3 -c "import sys,json; print(len(json.load(sys.stdin)))")
    if [[ "${BRANCH_COUNT}" != "2" ]]; then
        echo "ERROR: expected 2 branches, got ${BRANCH_COUNT}"
        errors=$((errors + 1))
    else
        echo "  branches: ${BRANCH_COUNT} OK"
    fi

    # Check PRs
    echo "==> Checking pull requests..."
    PR_RESP=$(curl -sf -u "${AUTH}" "${BASE}/repos/atlas-labs/checkout-service/pulls?state=all")
    PR_COUNT=$(echo "${PR_RESP}" | python3 -c "import sys,json; print(len(json.load(sys.stdin)))")
    if [[ "${PR_COUNT}" != "1" ]]; then
        echo "ERROR: expected 1 PR, got ${PR_COUNT}"
        errors=$((errors + 1))
    else
        echo "  prs: ${PR_COUNT} OK"
    fi

    # Check releases
    echo "==> Checking releases..."
    RELEASES_RESP=$(curl -sf -u "${AUTH}" "${BASE}/repos/atlas-labs/checkout-service/releases")
    RELEASE_COUNT=$(echo "${RELEASES_RESP}" | python3 -c "import sys,json; print(len(json.load(sys.stdin)))")
    if [[ "${RELEASE_COUNT}" != "1" ]]; then
        echo "ERROR: expected 1 release, got ${RELEASE_COUNT}"
        errors=$((errors + 1))
    else
        echo "  releases: ${RELEASE_COUNT} OK"
    fi

    # Check wiki pages
    echo "==> Checking wiki pages..."
    WIKI_RESP=$(curl -sf -u "${AUTH}" "${BASE}/repos/atlas-labs/checkout-service/wiki/pages")
    WIKI_COUNT=$(echo "${WIKI_RESP}" | python3 -c "import sys,json; items=json.load(sys.stdin); print(len(items) if isinstance(items, list) else 0)")
    if [[ "${WIKI_COUNT}" != "1" ]]; then
        echo "ERROR: expected 1 wiki page, got ${WIKI_COUNT}"
        errors=$((errors + 1))
    else
        echo "  wiki_pages: ${WIKI_COUNT} OK"
    fi

    if [[ "${errors}" -eq 0 ]]; then
        echo "==> Verification complete: all checks passed."
    else
        echo "==> Verification FAILED: ${errors} error(s)."
        exit 1
    fi
}

cmd_reset() {
    echo "==> Resetting environment..."
    docker stop "${CONTAINER_NAME}" 2>/dev/null || true
    docker rm "${CONTAINER_NAME}" 2>/dev/null || true
    docker volume rm "${DATA_VOLUME}" 2>/dev/null || true
    echo "==> Reset complete. Run 'deploy' to start fresh."
}

cmd_stop() {
    echo "==> Stopping container..."
    docker stop "${CONTAINER_NAME}" 2>/dev/null || true
    echo "==> Stopped."
}

cmd_logs() {
    docker logs -f "${CONTAINER_NAME}" 2>/dev/null || echo "Container not running."
}

cmd_status() {
    if docker ps --filter "name=${CONTAINER_NAME}" --format "{{.Names}}" | grep -q "${CONTAINER_NAME}"; then
        echo "Status: RUNNING"
        echo "URL: http://localhost:${PORT}"
        echo "Container: ${CONTAINER_NAME}"
    else
        echo "Status: NOT RUNNING"
    fi
}

cmd_help() {
    cat <<EOF
Gitea - Tester Environment CLI

Usage: ./tester-env <command> [--ref <git-ref>] [--run-id <id>] [--port <port>]

Commands:
  deploy    Build image, start container, create admin user
  seed      Populate app with deterministic seed data (Atlas Labs)
  verify    Run API verification against seeded state
  reset     Stop container, remove container and data volume
  stop      Stop container (preserves data)
  logs      Tail container logs
  status    Show container status
  help      Show this help message

Options:
  --ref <git-ref>   Git ref (branch, tag, or commit) to checkout before deploy.
                    Useful for deploying specific scenario baselines or mutants.
  --run-id <id>     Isolate container and volume names for parallel runs.
                    Default: default
  --port <port>     Host port to bind to container port 3000.
                    Default: 3000

Typical workflow:
  ./tester-env deploy              # Deploy baseline
  ./tester-env seed                # Populate with Atlas Labs data
  ./tester-env verify              # Check seeded state
  ./tester-env reset               # Clean slate

Scenario workflow:
  ./tester-env deploy --ref <sha> --run-id run-001 --port 3100
  ./tester-env seed --run-id run-001
  ./tester-env verify --run-id run-001
  ./tester-env reset --run-id run-001

Credentials: admin / admin
Seed users: alice / alice123, bob / bob123, charlie / charlie123

Branches:
  tester-env-baseline   Contains CLI, Dockerfile, seed scripts, and DEPLOY-SMA.md
  scenario/<id>/pass    Expected-to-pass scenario baseline
  scenario/<id>/fail    Expected-to-fail scenario mutant
EOF
}

main() {
    local cmd="${1:-help}"
    local ref=""

    # Parse optional arguments
    for ((i=2; i<=$#; i++)); do
        local arg="${!i}"
        case "${arg}" in
            --ref)
                local next=$((i+1))
                if [[ ${next} -le $# ]]; then
                    ref="${!next}"
                    ((i++))
                else
                    echo "Error: --ref requires a value"
                    exit 1
                fi
                ;;
            --run-id)
                local next=$((i+1))
                if [[ ${next} -le $# ]]; then
                    RUN_ID="${!next}"
                    ((i++))
                else
                    echo "Error: --run-id requires a value"
                    exit 1
                fi
                ;;
            --port)
                local next=$((i+1))
                if [[ ${next} -le $# ]]; then
                    PORT="${!next}"
                    ((i++))
                else
                    echo "Error: --port requires a value"
                    exit 1
                fi
                ;;
            --help|-h)
                cmd_help
                exit 0
                ;;
            *)
                echo "Unknown option: ${arg}"
                cmd_help
                exit 1
                ;;
        esac
    done

    refresh_names

    case "${cmd}" in
        deploy) cmd_deploy "${ref}" ;;
        seed) cmd_seed ;;
        verify) cmd_verify ;;
        reset) cmd_reset ;;
        stop) cmd_stop ;;
        logs) cmd_logs ;;
        status) cmd_status ;;
        help|--help|-h) cmd_help ;;
        *)
            echo "Unknown command: ${cmd}"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
